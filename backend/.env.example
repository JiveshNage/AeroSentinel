# ==============================================================================
# AeroSentinel — Backend Production Environment Configuration Template
# SIH Problem Statement: SIH26073
# DO NOT commit real secrets to source control. Copy this file to .env and fill in.
# ==============================================================================

# Application Environment & Debugging
APP_NAME=AeroSentinel
APP_ENV=production
APP_DEBUG=false
API_V1_STR=/api
PORT=8000

# Database Configuration (Supabase PostgreSQL)
# Note: For Supabase Transaction Pooler (recommended for serverless/Render), use port 6543
# Format: postgresql+psycopg2://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Cloud Platform Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
# SERVER-SIDE ONLY: NEVER EXPOSE SERVICE_ROLE_KEY TO THE BROWSER OR FRONTEND
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Authentication & Security
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Production CORS Origins (Comma-separated list of allowed origins)
# Include your Vercel deployment URL and localhost for local development
CORS_ORIGINS=https://aerosentinel.vercel.app,http://localhost:5173,http://localhost:3000

# Meteorological Data Sources
OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive

# Redis Caching & PubSub (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/0

# ML Model Pipelines & Retraining Storage
MODEL_STORAGE_PATH=backend/ml_engine/models
ENABLE_ONLINE_RETRAINING=true
QC_CONFIDENCE_THRESHOLD=0.85
