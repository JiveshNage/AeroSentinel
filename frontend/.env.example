# ==============================================================================
# AeroSentinel — Frontend Production Environment Configuration Template
# React + TypeScript + Vite
# DO NOT expose private secrets (such as SUPABASE_SERVICE_ROLE_KEY) here!
# ==============================================================================

# Backend API URL (Production Render endpoint or proxy)
# When deploying to Vercel, set to your Render backend URL (e.g., https://aerosentinel-backend.onrender.com)
VITE_API_URL=https://aerosentinel-backend.onrender.com

# Supabase Public Configuration (Safe for browser client)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Carto Basemaps Tile Service URL
VITE_CARTO_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_3wto_1_98681061742df32c284b0e0b
