# ==============================================================================
# AeroSentinel — Root Environment Template
# SIH Problem Statement: SIH26073
# ==============================================================================

# Application Environment
APP_NAME=AeroSentinel
ENVIRONMENT=production
APP_DEBUG=false
API_V1_STR=/api
PORT=8000

# Backend Supabase PostgreSQL Connection
# Transaction pooler connection string (port 6543)
DATABASE_URL=postgresql+psycopg2://postgres.your-project-ref:your-db-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Platform Credentials
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Frontend Environment Variables (Vite prefixed)
VITE_API_URL=https://aerosentinel-backend.onrender.com
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
VITE_CARTO_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=cb1_3wto_1_98681061742df32c284b0e0b

# Security & Secrets
JWT_SECRET_KEY=your-secure-random-jwt-secret-key-min-32-chars
CORS_ORIGINS=https://aerosentinel.vercel.app,http://localhost:5173,http://localhost:3000