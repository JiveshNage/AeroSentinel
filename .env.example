# AeroSentinel Environment Configuration

# App
APP_NAME=AeroSentinel
ENVIRONMENT=development
API_V1_STR=/api

# Database (PostgreSQL 15 + TimescaleDB)
POSTGRES_USER=aerosentinel
POSTGRES_PASSWORD=aerosentinel
POSTGRES_DB=aerosentinel
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg2://aerosentinel:aerosentinel@timescaledb:5432/aerosentinel

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
